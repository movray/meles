          },
          "expr": "sum by (priority) (meles_operator_scan_queue{job=~\"$job\"})",
          "legendFormat": "{{priority}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(meles_operator_scans_running{job=~\"$job\"})",
          "legendFormat": "running",
          "refId": "B"
        }
