    {
      "type": "timeseries",
      "title": "Leader",
      "description": "The replica that scans (1). The others serve only the scan gate's webhook.",
      "id": 16,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
