    {
      "type": "stat",
      "title": "Released unscanned (24h)",
      "description": "Pods the scan gate released without a complete scan (engine outage with fail-open, or audit mode).",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "round(sum(increase(meles_operator_gate_released_total{job=~\"$job\",scan=\"unscanned\"}[24h]))) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "0",
